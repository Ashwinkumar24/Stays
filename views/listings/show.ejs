<% layout("/layouts/boilerplate.ejs") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
</script>

<style> .listing-page { max-width: 1100px; margin: 40px auto; } /* Main listing card */ .listing-main-card { border: none; border-radius: 24px; overflow: hidden; background: #fff; box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08); } .listing-image { width: 100%; height: 430px; object-fit: cover; display: block; } .listing-content { padding: 30px; } .listing-title { font-size: 2rem; font-weight: 700; color: #222; margin-bottom: 18px; } .owner { color: #666; font-size: 0.95rem; margin-bottom: 20px; } .owner i { color: #fe424d; font-weight: 600; } .description { color: #555; font-size: 1.05rem; line-height: 1.7; margin-bottom: 25px; } /* Listing details */ .listing-details { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin-top: 20px; } .detail-box { background: #f8f9fa; padding: 16px; border-radius: 14px; border: 1px solid #eee; } .detail-label { font-size: 0.8rem; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; } .detail-value { font-size: 1rem; font-weight: 600; color: #333; } .price { font-size: 1.4rem; color: #fe424d; font-weight: 700; } /* Buttons */ .listing-actions { display: flex; gap: 12px; margin-top: 25px; } .edit-btn { background: #fe424d; color: white; border: none; padding: 11px 22px; border-radius: 10px; font-weight: 600; transition: 0.2s ease; } .edit-btn:hover { background: #e63640; color: white; transform: translateY(-2px); } .delete-btn { border-radius: 10px; padding: 11px 22px; font-weight: 600; } /* Reviews section */ .reviews-section { margin-top: 50px; } .section-title { font-size: 1.7rem; font-weight: 700; margin-bottom: 25px; color: #222; } /* Review form */ .review-form { background: #fff; border-radius: 20px; padding: 30px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07); border: 1px solid #eee; margin-bottom: 45px; } .review-form h4 { font-weight: 700; margin-bottom: 22px; } .form-label { font-weight: 600; color: #333; } .comment-box { border-radius: 12px; border: 1px solid #ddd; padding: 12px; resize: vertical; } .comment-box:focus { border-color: #fe424d; box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.1); } .submit-review { background: #222; color: white; border: none; border-radius: 10px; padding: 11px 25px; font-weight: 600; transition: 0.2s ease; } .submit-review:hover { background: #fe424d; color: white; transform: translateY(-2px); } /* Review cards */ .review-card { border: none; border-radius: 18px; padding: 5px; box-shadow: 0 7px 25px rgba(0, 0, 0, 0.07); transition: 0.2s ease; height: 100%; } .review-card:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1); } .review-card .card-body { padding: 22px; } .review-user { font-weight: 700; color: #333; margin-bottom: 12px; } .review-comment { color: #666; line-height: 1.6; min-height: 50px; } .review-rating { margin-top: 15px; margin-bottom: 12px; } .review-delete { padding: 0 22px 18px; } .review-delete button { border-radius: 8px; } /* Divider */ .section-divider { border: none; border-top: 1px solid #eee; margin: 45px 0; } /* Mobile */ @media (max-width: 768px) { .listing-page { margin: 20px 12px; } .listing-image { height: 280px; } .listing-content { padding: 22px; } .listing-title { font-size: 1.6rem; } .listing-details { grid-template-columns: 1fr; } .listing-actions { flex-direction: column; } .listing-actions a, .listing-actions form, .listing-actions button { width: 100%; } .review-form { padding: 22px; } } </style> <div class="listing-page"> <!-- LISTING --> <div class="listing-main-card">
<img
  src="<%= listing.image.url %>"
  class="listing-image"
  alt="listing image"
/>

<div class="listing-content">

  <h1 class="listing-title">
    <%= listing.title %>
  </h1>

  <p class="owner">
    Hosted by <i><%= listing.owner.username %></i>
  </p>

  <p class="description">
    <%= listing.description %>
  </p>


  <!-- Listing Details -->

  <div class="listing-details">

    <div class="detail-box">
      <div class="detail-label">Price</div>
      <div class="detail-value price">
        &#8377;<%= listing.price.toLocaleString("en-IN") %>
      </div>
    </div>

    <div class="detail-box">
      <div class="detail-label">Location</div>
      <div class="detail-value">
        📍 <%= listing.location %>
      </div>
    </div>

    <div class="detail-box">
      <div class="detail-label">Country</div>
      <div class="detail-value">
        🌎 <%= listing.country %>
      </div>
    </div>

  </div>


  <!-- Owner Actions -->

  <% if (currUser && currUser._id.equals(listing.owner._id)) { %>

    <div class="listing-actions">

      <a
        href="/listings/<%= listing._id %>/edit"
        class="btn edit-btn"
      >
        ✏️ Edit Listing
      </a>

      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=DELETE"
      >
        <button
          type="submit"
          class="btn btn-dark delete-btn"
        >
          🗑️ Delete Listing
        </button>
      </form>

    </div>

  <% } %>

</div>

</div> 


<!-- REVIEWS --> 
<div class="reviews-section">
<hr class="section-divider">


<!-- Review Form -->

<% if (currUser) { %>

  <div class="review-form">

    <h4>
      ⭐ Leave a Review
    </h4>

    <form
      action="/listings/<%= listing._id %>/reviews"
      method="POST"
      novalidate
      class="needs-validation"
    >

      <!-- Star Rating -->

      <div class="mb-4">

        <label class="form-label d-block">
          How was your experience?
        </label>

        <fieldset class="starability-basic">

          <legend class="visually-hidden">
            Rating
          </legend>

          <input
            type="radio"
            id="no-rate"
            class="input-no-rate"
            name="review[rating]"
            value="0"
            checked
            aria-label="No rating"
          />

          <input
            type="radio"
            id="first-rate1"
            name="review[rating]"
            value="1"
          />
          <label
            for="first-rate1"
            title="Terrible"
          >
            1 star
          </label>

          <input
            type="radio"
            id="first-rate2"
            name="review[rating]"
            value="2"
          />
          <label
            for="first-rate2"
            title="Not good"
          >
            2 stars
          </label>

          <input
            type="radio"
            id="first-rate3"
            name="review[rating]"
            value="3"
          />
          <label
            for="first-rate3"
            title="Average"
          >
            3 stars
          </label>

          <input
            type="radio"
            id="first-rate4"
            name="review[rating]"
            value="4"
          />
          <label
            for="first-rate4"
            title="Very good"
          >
            4 stars
          </label>

          <input
            type="radio"
            id="first-rate5"
            name="review[rating]"
            value="5"
          />
          <label
            for="first-rate5"
            title="Amazing"
          >
            5 stars
          </label>

        </fieldset>

      </div>


      <!-- Comment -->

      <div class="mb-4">

        <label
          for="comment"
          class="form-label"
        >
          Your comments
        </label>

        <textarea
          name="review[comments]"
          id="comment"
          rows="5"
          class="form-control comment-box"
          placeholder="Share your experience..."
          required
        ></textarea>

        <div class="invalid-feedback">
          Please add some comments for your review!
        </div>

      </div>


      <button
        type="submit"
        class="btn submit-review"
      >
        Submit Review
      </button>

    </form>

  </div>

<% } %>


<!-- All Reviews -->

<h2 class="section-title">
  💬 Guest Reviews
</h2>


<div class="row g-4">

  <% if (listing.reviews.length === 0) { %>

    <div class="col-12">

      <div class="text-center py-5">

        <div style="font-size: 3rem;">
          💭
        </div>

        <h5 class="mt-3">
          No reviews yet
        </h5>

        <p class="text-muted">
          Be the first person to review this listing!
        </p>

      </div>

    </div>

  <% } %>


  <% for (review of listing.reviews) { %>

    <div class="col-md-6">

      <div class="card review-card">

        <div class="card-body">

          <h5 class="review-user">
            👤 @<%= review.author.username %>
          </h5>

          <p class="review-comment">
            <%= review.comments %>
          </p>


          <!-- Actual Star Rating -->

          <div class="review-rating">

            <p
              class="starability-result"
              data-rating="<%= review.rating %>"
            ></p>

          </div>

        </div>


        <!-- Delete Review -->

        <div class="review-delete">

          <form
            method="POST"
            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
          >

            <button
              type="submit"
              class="btn btn-sm btn-outline-dark"
            >
              🗑️ Delete
            </button>

          </form>

        </div>

      </div>

    </div>

  <% } %>

</div>


</div>
<!-- MAP SECTION -->
<div class="map-section">

  <div class="map-header">
    <h2>Where you'll be</h2>
    <p>Explore the location of this listing</p>
  </div>

  <div class="map-container">
    <div id="map"></div>
  </div>

</div>

<script src="/js/map.js"></script>

</div>



